generator client {
  provider     = "prisma-client"
  output       = "../prisma/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model CartItem {
  // Immutable fields
  id         String @id @default(uuid()) @db.Uuid
  customerId String @map("customer_id") @db.VarChar(250)

  // Mutable fields
  quantity Int @default(1) @db.Integer

  // Foreign keys
  menuItemId String @map("menu_item_id") @db.Uuid

  // Back relation fields
  menuItem MenuItem @relation(fields: [menuItemId], onDelete: Cascade, references: [id])

  // Constraints
  @@unique([customerId, menuItemId])
  @@map("cart_items")
}

model MenuCategory {
  // Immutable fields
  id String @id @default(uuid()) @db.Uuid

  // Mutable fields
  name String @unique @db.VarChar(20)

  // Front relation fields
  menuItems MenuItem[]

  // Constraints
  @@map("menu_categories")
}

model MenuItem {
  // Immutable fields
  id          String    @id @default(uuid()) @db.Uuid
  archivedAt  DateTime? @map("archived_at") @db.Timestamp() // initially null, can be set if at least 1 orderedItem is connected to this menuItem
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp()
  publishedAt DateTime? @map("published_at") @db.Timestamp() // initially null, will be set when `isVisible` is set to true for the first time

  // Mutable fields
  description    String   @db.VarChar(500)
  image          String   @db.VarChar(2048)
  inStock        Int      @default(0) @map("in_stock") @db.Integer
  isPreOrderOnly Boolean  @map("is_pre_order_only") @db.Boolean
  isVisible      Boolean  @default(false) @map("is_visible") @db.Boolean
  name           String   @db.VarChar(50)
  orderCount     Int      @default(0) @map("order_count") @db.Integer // automatically updated
  prepTime       Int      @map("prep_time") @db.Integer
  price          Decimal  @db.Decimal(10, 2)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp()

  // Front relation fields
  cartItems         CartItem[]
  menuCategories    MenuCategory[]
  orderedItems      OrderedItem[]
  reviews           Review[]
  subscriptionItems SubscriptionItem[]

  // Constraints
  @@map("menu_items")
}

model Order {
  // Immutable fields
  id         String    @id @default(uuid()) @db.Uuid
  amount     Decimal   @db.Decimal(10, 2)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp()
  customerId String?   @map("customer_id") @db.VarChar(250) // will be set to null if customer deletes their account
  orderType  OrderType @map("order_type")

  // If the orderType is PICKUP or WALK_IN, the following fields will remain null
  deliveryStreet     String? @map("delivery_street") @db.VarChar(250)
  deliveryCity       String? @map("delivery_city") @db.VarChar(100)
  deliveryPostalCode String? @map("delivery_postal_code") @db.VarChar(20)
  deliveryLatitude   Float?  @map("delivery_latitude") @db.DoublePrecision
  deliveryLongitude  Float?  @map("delivery_longitude") @db.DoublePrecision

  orderStatus      OrderStatus   @map("order_status")
  riderId          String?       @map("rider_id") @db.VarChar(250) // initially null, will be set when a rider is assigned to the order
  paymentStatus    PaymentStatus @default(UNPAID) @map("payment_status")
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamp()
  verificationCode String?       @map("verification_code") @db.VarChar(6) // automatically updated

  // Foreign keys
  subscriptionId String? @map("subscription_id") @db.Uuid

  // Front relation fields
  orderedItems OrderedItem[]
  refunds      Refund[]
  reviews      Review[]

  // Back relation fields
  subscription Subscription? @relation(fields: [subscriptionId], onDelete: SetNull, references: [id])

  // Constraints
  @@map("orders")
}

model OrderedItem {
  // Immutable fields
  id       String  @id @default(uuid()) @db.Uuid
  price    Decimal @db.Decimal(10, 2)
  quantity Int     @db.Integer

  // Foreign keys
  menuItemId String @map("menu_item_id") @db.Uuid
  orderId    String @map("orderId") @db.Uuid

  // Front relation fields
  refunds Refund[]

  // Back relation fields
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
  order    Order    @relation(fields: [orderId], references: [id])

  // Constraints
  @@unique([orderId, menuItemId])
  @@map("ordered_items")
}

model Refund {
  // Immutable fields
  id        String   @id @default(uuid()) @db.Uuid
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp()
  reason    String?  @db.VarChar(500)

  // Foreign keys
  orderId       String  @map("order_id") @db.Uuid
  orderedItemId String? @map("ordered_item_id") @db.Uuid

  // Back relation fields
  order       Order        @relation(fields: [orderId], references: [id])
  orderedItem OrderedItem? @relation(fields: [orderedItemId], references: [id])

  // Constraints
  @@map("refunds")
}

model Review {
  // Immutable fields
  id         String   @id @default(uuid()) @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp()
  customerId String   @map("customer_id") @db.VarChar(250)

  // Mutable fields
  comment   String?  @db.VarChar(500)
  rating    Int      @db.Integer
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp()

  // Foreign keys
  menuItemId String? @map("menu_item_id") @db.Uuid
  orderId    String? @map("orderId") @db.Uuid

  // Back relation fields
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id])
  order    Order?    @relation(fields: [orderId], references: [id])

  // Constraints
  @@unique([customerId, menuItemId])
  @@unique([customerId, orderId])
  @@map("reviews")
}

model Subscription {
  // Immutable fields
  id         String   @id @default(uuid()) @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp()
  customerId String   @map("customer_id") @db.VarChar(250)

  // Mutable fields
  deliveryStreet     String   @map("delivery_street") @db.VarChar(250)
  deliveryCity       String   @map("delivery_city") @db.VarChar(100)
  deliveryPostalCode String   @map("delivery_postal_code") @db.VarChar(20)
  deliveryLatitude   Float    @map("delivery_latitude") @db.DoublePrecision
  deliveryLongitude  Float    @map("delivery_longitude") @db.DoublePrecision
  isActive           Boolean  @default(false) @map("is_active") @db.Boolean
  isApproved         Boolean  @default(false) @map("is_approved") @db.Boolean
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamp()

  // Front relation fields
  orders            Order[]
  subscriptionItems SubscriptionItem[]

  // Constraints
  @@map("subscriptions")
}

model SubscriptionItem {
  // Immutable fields
  id       String @id @default(uuid()) @db.Uuid
  quantity Int    @db.Integer

  // Mutable fields
  onMondays    ScheduleSlot[] @default([]) @map("on_mondays")
  onTuesdays   ScheduleSlot[] @default([]) @map("on_tuesdays")
  onWednesdays ScheduleSlot[] @default([]) @map("on_wednesdays")
  onThursdays  ScheduleSlot[] @default([]) @map("on_thursdays")
  onFridays    ScheduleSlot[] @default([]) @map("on_fridays")
  onSaturdays  ScheduleSlot[] @default([]) @map("on_saturdays")
  onSundays    ScheduleSlot[] @default([]) @map("on_sundays")

  // Foreign keys
  menuItemId     String @map("menu_item_id") @db.Uuid
  subscriptionId String @map("subscription_id") @db.Uuid

  // Back relation fields
  menuItem     MenuItem     @relation(fields: [menuItemId], onDelete: Cascade, references: [id])
  subscription Subscription @relation(fields: [subscriptionId], onDelete: Cascade, references: [id])

  // Constraints
  @@unique([subscriptionId, menuItemId])
  @@map("subscription_items")
}

enum OrderType {
  DELIVERY     @map("delivery") // will be delivered to the customer by a rider
  PICKUP       @map("pickup") // will be picked up by the customer
  WALK_IN      @map("walk_in") // will be handled by the staff, no rider or delivery address needed
  SUBSCRIPTION @map("subscription") // same as DELIVERY, but will be ordered automatically on a routine basis
}

enum OrderStatus {
  // Will be set by customer
  PENDING @map("pending") // 1st if DELIVERY or PICKUP type

  // Will be set by bakery
  ACCEPTED   @map("accepted") // 1st if WALK_IN or SUBSCRIPTION type, otherwise 2nd
  REJECTED   @map("rejected") // 2nd if DELIVERY or PICKUP type | final status
  COMPLETED  @map("completed") // 3rd if WALK_IN type | final status
  PREPARING  @map("preparing") // 3rd
  READY      @map("ready") // 4th
  PICKED_UP  @map("picked_up") // 5th if PICKUP type | final status
  IN_TRANSIT @map("in_transit") // 5th if DELIVERY or SUBSCRIPTION type
  DELIVERED  @map("delivered") // 6th if DELIVERY or SUBSCRIPTION type | final status
  FAILED     @map("failed") // 6th if DELIVERY or SUBSCRIPTION type | Final status

  // Special case scenario
  CANCELLED @map("cancelled") // Can be set only during PENDING and ACCEPTED | final status
}

enum PaymentStatus {
  PAID   @map("paid")
  UNPAID @map("unpaid")
}

enum ScheduleSlot {
  SLOT_0900 @map("slot_0900")
  SLOT_0930 @map("slot_0930")
  SLOT_1000 @map("slot_1000")
  SLOT_1030 @map("slot_1030")
  SLOT_1100 @map("slot_1100")
  SLOT_1130 @map("slot_1130")
  SLOT_1200 @map("slot_1200")
  SLOT_1230 @map("slot_1230")
  SLOT_1300 @map("slot_1300")
  SLOT_1330 @map("slot_1330")
  SLOT_1400 @map("slot_1400")
  SLOT_1430 @map("slot_1430")
  SLOT_1500 @map("slot_1500")
  SLOT_1530 @map("slot_1530")
  SLOT_1600 @map("slot_1600")
  SLOT_1630 @map("slot_1630")
  SLOT_1700 @map("slot_1700")
  SLOT_1730 @map("slot_1730")
  SLOT_1800 @map("slot_1800")
  SLOT_1830 @map("slot_1830")
  SLOT_1900 @map("slot_1900")
  SLOT_1930 @map("slot_1930")
  SLOT_2000 @map("slot_2000")
  SLOT_2030 @map("slot_2030")
}
